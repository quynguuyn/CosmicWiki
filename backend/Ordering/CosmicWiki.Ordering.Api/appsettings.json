{
  "ConnectionStrings": {
    "OrderingDatabase": "User Id=COSMICWIKI_ORDERING;Password=[SECRET_FROM_ENV];Data Source=localhost:1523/FREEPDB1",
    "PaymentsDatabase": "User Id=COSMICWIKI_PAYMENTS;Password=[SECRET_FROM_ENV];Data Source=localhost:1523/FREEPDB1",
    "ProductDatabase": "User Id=COSMICWIKI_PRODUCT;Password=[SECRET_FROM_ENV];Data Source=localhost:1523/FREEPDB1"
  },
  "Jwt": {
    "Issuer": "CosmicWiki",
    "Audience": "CosmicWiki",
    "PublicKeyPath": "Keys/public_key.pem"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "cosmicwiki-ordering",
    "SecurityProtocol": "Plaintext",
    "EnableIdempotence": true,
    "PaymentStatusConsumerGroup": "cosmicwiki.ordering.payment-status",
    "PaymentStatusMaxProcessingAttempts": 3,
    "PaymentStatusRetryBackoffMilliseconds": 250
  },
  "PaymentProvider": {
    "Mode": "Disabled"
  },
  "InternalOrdering": {
    "ServiceKey": "[SECRET_FROM_ENV]"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
