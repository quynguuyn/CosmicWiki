{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        }
      },
      "product-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/product/{**catch-all}"
        }
      },
      "stories-route": {
        "ClusterId": "stories-cluster",
        "Match": {
          "Path": "/api/stories/{**catch-all}"
        }
      },
      "discovery-route": {
        "ClusterId": "discovery-cluster",
        "Match": {
          "Path": "/api/discovery/{**catch-all}"
        }
      },
      "ordering-route": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "admin-orders-route": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/api/admin/orders/{**catch-all}"
        }
      },
      "admin-jobs-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/admin/jobs/{**catch-all}"
        }
      },
      "carts-route": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/api/carts/{**catch-all}"
        }
      },
      "payment-webhook-route": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/api/payments/webhooks/{**catch-all}"
        }
      },
      "visit-route": {
        "ClusterId": "visit-cluster",
        "Match": {
          "Path": "/api/visit/{**catch-all}"
        }
      },
      "newsletter-route": {
        "ClusterId": "newsletter-cluster",
        "Match": {
          "Path": "/api/newsletter/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-api": {
            "Address": "http://cosmicwiki-auth-1:8080/"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-api": {
            "Address": "http://cosmicwiki-catalog-1:8080/"
          }
        }
      },
      "product-cluster": {
        "Destinations": {
          "product-api": {
            "Address": "http://cosmicwiki-product-1:8080/"
          }
        }
      },
      "discovery-cluster": {
        "Destinations": {
          "discovery-api": {
            "Address": "http://cosmicwiki-discovery-1:8080/"
          }
        }
      },
      "visit-cluster": {
        "Destinations": {
          "visit-api": {
            "Address": "http://cosmicwiki-visit-1:8080/"
          }
        }
      },
      "ordering-cluster": {
        "Destinations": {
          "ordering-api": {
            "Address": "http://cosmicwiki-ordering-1:8080/"
          }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "payments-api": {
            "Address": "http://cosmicwiki-payments-1:8080/"
          }
        }
      },
      "stories-cluster": {
        "Destinations": {
          "stories-api": {
            "Address": "http://cosmicwiki-stories-1:8080/"
          }
        }
      },
      "newsletter-cluster": {
        "Destinations": {
          "newsletter-api": {
            "Address": "http://cosmicwiki-newsletter-1:8080/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}