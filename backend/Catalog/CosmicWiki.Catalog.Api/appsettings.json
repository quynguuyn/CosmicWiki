{
  "ConnectionStrings": {
    "CatalogDatabase": "User Id=COSMICWIKI_CATALOG;Password=[SECRET_FROM_ENV];Data Source=localhost:1523/FREEPDB1"
  },
  "Jwt": {
    "Issuer": "CosmicWiki",
    "Audience": "CosmicWiki",
    "PublicKeyPath": "Keys/public_key.pem"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Caching": {
    "Enabled": true,
    "CatalogDetailTtlSeconds": 120,
    "CatalogListTtlSeconds": 60,
    "Redis": {
      "ConnectionString": "localhost:6379",
      "InstanceName": "cosmicwiki:catalog:"
    }
  },
  "AllowedHosts": "*"
}