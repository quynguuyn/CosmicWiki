{
  "ConnectionStrings": {
    "PaymentsDatabase": "User Id=COSMICWIKI_PAYMENTS;Password=[SECRET_FROM_ENV];Data Source=localhost:1523/FREEPDB1"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "cosmicwiki-payments",
    "SecurityProtocol": "Plaintext",
    "EnableIdempotence": true
  },
  "OrderingService": {
    "BaseUrl": "http://localhost:5006",
    "AllowHttp": true,
    "ServiceKey": "[SECRET_FROM_ENV]"
  },
  "PaymentWebhook": {
    "SharedSecret": "[SECRET_FROM_ENV]",
    "SignatureHeader": "X-Payment-Signature",
    "TimestampHeader": "X-Payment-Timestamp",
    "RequireTimestamp": true,
    "TimestampToleranceSeconds": 300,
    "MaxBodyBytes": 1048576
  },
  "StripeWebhook": {
    "SigningSecret": "[SECRET_FROM_ENV]",
    "TimestampToleranceSeconds": 300,
    "MaxBodyBytes": 1048576
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
