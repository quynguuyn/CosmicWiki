{
  "ConnectionStrings": {
    "ProductDatabase": "User Id=COSMICWIKI_PRODUCT;Password=[SECRET_FROM_ENV];Data Source=localhost:1523/FREEPDB1"
  },
  "Jwt": {
    "Issuer": "CosmicWiki",
    "Audience": "CosmicWiki",
    "PublicKeyPath": "Keys/public_key.pem"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Caching": {
    "Enabled": false,
    "ProductDetailTtlSeconds": 30,
    "ProductListTtlSeconds": 30,
    "Redis": {
      "ConnectionString": "localhost:6379",
      "InstanceName": "cosmicwiki:product:"
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
